{
    "name": "UbiChrV3 - Ubiquity for Chrome",
    "short_name": "UbiChrV3",
    "homepage_url": "https://github.com/rostok/ubichr",
    "author": "rostok",
    "version": "3.0.0.4",
    "description": "Revived Ubiquity for Chrome",
    "manifest_version": 3,
    "background": {
        "service_worker": "service_worker.js"
    },
    "action": {
        "default_title": "UbiChr",
        "default_popup": "popup.html",
        "default_icon": "res/icon-128.png"
    },
    "sandbox": {
        "pages": ["sandbox.html"]
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "chromeos": "Ctrl+Space",
                "linux": "Ctrl+Space",
                "mac": "Command+Space",
                "windows": "Ctrl+Space"
            }
        }
    },
    "content_scripts": [{
        "matches": ["<all_urls>"],
        "js": ["selection.js"]
    }],
    "icons": { "128" : "res/icon-128.png" },
    "permissions": [
        "activeTab",
        "tabs",
        "scripting",
        "clipboardRead",
        "clipboardWrite",
        "notifications",
        "storage",
        "alarms",
        "cookies",
        "userScripts"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'",
        "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval'; object-src 'self'"
    }
}
